#!/usr/bin/env bash
# devbox-secrets: host-side control of the box age key (tmpfs) and admin edits of the secrets repo.
#   unlock | lock | status [--container <name>] | edit <project> <env>
# The runtime dir is bind-mounted into the container, so it is never deleted or recreated:
# only the age.key file inside it comes and goes.
set -euo pipefail

RUNTIME_DIR=${DEVBOX_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/devbox}
KEY_ENC=${DEVBOX_KEY_ENC:-$HOME/.config/devbox/box.key.age}
SECRETS_REPO=${DEVBOX_SECRETS_REPO:-$HOME/src/secrets}
ADMIN_KEY=${DEVBOX_ADMIN_KEY:-$HOME/.config/devbox/admin.key}
AGE_DECRYPT=${DEVBOX_AGE_DECRYPT:-age -d}
KEY_FILE=$RUNTIME_DIR/age.key

usage() {
  cat >&2 <<'USAGE'
usage: devbox-secrets unlock
       devbox-secrets lock
       devbox-secrets status [--container <name>]
       devbox-secrets edit <project> <env>
USAGE
  exit 2
}

ensure_dir() { [ -d "$RUNTIME_DIR" ] || mkdir -p "$RUNTIME_DIR"; }

cmd_unlock() {
  [ $# -eq 0 ] || usage
  umask 077
  ensure_dir
  local tmp
  tmp=$(mktemp "$RUNTIME_DIR/.age.key.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  # shellcheck disable=SC2086  # AGE_DECRYPT may be a command with arguments
  if ! $AGE_DECRYPT "$KEY_ENC" > "$tmp"; then
    echo "devbox-secrets: decrypt failed" >&2
    exit 1
  fi
  [ -s "$tmp" ] || { echo "devbox-secrets: decrypt produced no key" >&2; exit 1; }
  mv -f "$tmp" "$KEY_FILE"
  trap - EXIT
}

cmd_lock() {
  [ $# -eq 0 ] || usage
  rm -f "$KEY_FILE"
}

cmd_status() {
  local container=""
  case $# in
    0) ;;
    2) [ "$1" = --container ] || usage; container=$2 ;;
    *) usage ;;
  esac
  local rc=1
  if [ -s "$KEY_FILE" ]; then echo unlocked; rc=0; else echo locked; fi
  if [ -n "$container" ]; then
    if ! command -v podman >/dev/null 2>&1; then
      echo "container: unknown"
    elif podman exec "$container" test -s /run/devbox-secrets/age.key >/dev/null 2>&1; then
      echo "container: unlocked"
    else
      # exit 125-127 mean podman/exec itself failed; anything else is test's verdict
      local prc=$?
      if [ "$prc" -ge 125 ]; then echo "container: unknown"; else echo "container: locked"; fi
    fi
  fi
  return "$rc"
}

# The file must already exist (create new ones by hand with `sops <path>` from the repo).
cmd_edit() {
  [ $# -eq 2 ] || usage
  local project=$1 env=$2
  [[ $project =~ ^[A-Za-z0-9_-]+$ && $env =~ ^[A-Za-z0-9_-]+$ ]] || {
    echo "devbox-secrets: invalid project or env name" >&2; exit 2; }
  if [ -z "${EDITOR:-}" ] || [[ $EDITOR == *--wait* ]]; then
    echo "devbox-secrets: set EDITOR to a blocking editor without --wait" >&2
    exit 2
  fi
  cd "$SECRETS_REPO" 2>/dev/null || { echo "devbox-secrets: secrets repo not found: $SECRETS_REPO" >&2; exit 1; }
  [ -f "$project/$env.env" ] || { echo "devbox-secrets: $project/$env.env does not exist" >&2; exit 1; }
  ensure_dir
  export TMPDIR=$RUNTIME_DIR SOPS_AGE_KEY_FILE=$ADMIN_KEY
  exec sops edit "$project/$env.env"
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
  unlock) cmd_unlock "$@" ;;
  lock) cmd_lock "$@" ;;
  status) cmd_status "$@" ;;
  edit) cmd_edit "$@" ;;
  *) usage ;;
esac

#!/usr/bin/env bash
# with-secrets <project> <env> -- <cmd> [args...]
# Runs <cmd> with the decrypted values of _global/<env>.env and <project>/<env>.env
# (project wins) in its environment. Plaintext never touches disk: sops exec-env only.
# Exit: 2 usage, 3 locked, 4 no such file, 5 decrypt failed, else the command's own code.
# Env: DEVBOX_SECRETS_DIR (default /secrets), DEVBOX_SECRETS_KEY (default /run/devbox-secrets/age.key)
set -euo pipefail

die() { echo "with-secrets: $2" >&2; exit "$1"; }
usage() { echo "usage: with-secrets <project> <env> -- <cmd> [args...]" >&2; exit 2; }

[ $# -ge 4 ] && [ "$3" = "--" ] || usage
project=$1; envname=$2; shift 3
re='^[A-Za-z0-9_-]+$'
[[ $project =~ $re ]] && [[ $envname =~ $re ]] || usage

dir=${DEVBOX_SECRETS_DIR:-/secrets}
key=${DEVBOX_SECRETS_KEY:-/run/devbox-secrets/age.key}

[ -s "$key" ] || { echo "locked: run devbox-secrets unlock on the host" >&2; exit 3; }

pfile=$dir/$project/$envname.env
gfile=$dir/_global/$envname.env
[ -f "$pfile" ] || die 4 "no such project/env: $project/$envname"

# Set only here; override whatever the caller had.
export SOPS_AGE_KEY_FILE=$key

# Pre-check decryption (output discarded) so decrypt failures are distinguishable
# from the wrapped command's own exit code.
check() { (cd "$dir" && sops decrypt --input-type dotenv --output-type dotenv "$1" >/dev/null 2>&1); }
check "$pfile" || die 5 "decrypt failed: $project/$envname"
if [ -f "$gfile" ]; then check "$gfile" || die 5 "decrypt failed: _global/$envname"; fi

# POSIX single-quote: ' -> '\''
q() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

cmd=""
for a in "$@"; do cmd+="$(q "$a") "; done
inner="sops exec-env --same-process $(q "$pfile") $(q "$cmd")"

if [ -f "$gfile" ]; then
  exec sops exec-env --same-process "$gfile" "$inner"
else
  exec sops exec-env --same-process "$pfile" "$cmd"
fi
